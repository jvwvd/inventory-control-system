<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        stylesheets="@../css/application.css"
        xmlns="http://javafx.com/javafx/25"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="controller.CategoryController">

    <top>
        <VBox spacing="15.0">

            <padding>
                <Insets
                        top="25.0"
                        right="25.0"
                        bottom="15.0"
                        left="25.0"/>
            </padding>

            <children>

                <Label
                        text="Category Management"
                        styleClass="page-title"/>

                <HBox spacing="10.0">

                    <children>

                        <TextField
                                fx:id="searchField"
                                prefWidth="300.0"
                                promptText="Search category name"/>

                        <Button
                                onAction="#handleSearch"
                                text="Search"
                                styleClass="primary-button"/>

                        <Button
                                onAction="#handleClear"
                                text="Clear"
                                styleClass="secondary-button"/>

                    </children>

                </HBox>

            </children>

        </VBox>
    </top>

    <center>

        <TableView
                fx:id="categoryTable">

            <BorderPane.margin>
                <Insets
                        top="0.0"
                        right="15.0"
                        bottom="25.0"
                        left="25.0"/>
            </BorderPane.margin>

            <columns>

                <TableColumn
                        fx:id="idColumn"
                        maxWidth="80.0"
                        minWidth="60.0"
                        prefWidth="70.0"
                        text="ID"/>

                <TableColumn
                        fx:id="categoryNameColumn"
                        minWidth="150.0"
                        prefWidth="200.0"
                        text="Category Name"/>

                <TableColumn
                        fx:id="descriptionColumn"
                        minWidth="220.0"
                        prefWidth="350.0"
                        text="Description"/>

            </columns>

        </TableView>

    </center>

    <right>

        <VBox
                prefWidth="300.0"
                spacing="12.0"
                styleClass="form-panel">

            <BorderPane.margin>
                <Insets
                        top="0.0"
                        right="25.0"
                        bottom="25.0"
                        left="10.0"/>
            </BorderPane.margin>

            <padding>
                <Insets
                        top="20.0"
                        right="20.0"
                        bottom="20.0"
                        left="20.0"/>
            </padding>

            <children>

                <Label
                        text="Category Details"
                        styleClass="form-title"/>

                <Label
                        text="Category Name"/>

                <TextField
                        fx:id="categoryNameField"
                        promptText="Enter category name"/>

                <Label
                        text="Description"/>

                <TextArea
                        fx:id="descriptionArea"
                        prefRowCount="5"
                        promptText="Enter description"
                        wrapText="true"/>

                <Button
                        maxWidth="Infinity"
                        onAction="#handleAdd"
                        text="Add Category"
                        styleClass="primary-button"/>

                <Button
                        maxWidth="Infinity"
                        onAction="#handleUpdate"
                        text="Update Category"
                        styleClass="secondary-button"/>

                <Button
                        maxWidth="Infinity"
                        onAction="#handleDelete"
                        text="Delete Category"
                        styleClass="danger-button"/>

                <Button
                        maxWidth="Infinity"
                        onAction="#handleClear"
                        text="Clear Form"/>

            </children>

        </VBox>

    </right>

</BorderPane>