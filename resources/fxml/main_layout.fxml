<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        fx:id="mainBorderPane"
        prefHeight="650.0"
        prefWidth="1000.0"
        stylesheets="@../css/application.css"
        xmlns="http://javafx.com/javafx/25"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="controller.MainLayoutController">

    <top>
        <HBox
                alignment="CENTER_LEFT"
                spacing="15.0"
                styleClass="top-bar">

            <padding>
                <Insets
                        top="15.0"
                        right="20.0"
                        bottom="15.0"
                        left="20.0"/>
            </padding>

            <children>
                <Label
                        text="Inventory Management System"
                        styleClass="header-title"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label
                        text="Logged in as:"
                        styleClass="header-label"/>

                <Label
                        fx:id="userNameLabel"
                        text="User"
                        styleClass="header-user"/>
            </children>
        </HBox>
    </top>

    <left>
        <VBox
                prefWidth="210.0"
                spacing="10.0"
                styleClass="side-menu">

            <padding>
                <Insets
                        top="25.0"
                        right="15.0"
                        bottom="25.0"
                        left="15.0"/>
            </padding>

            <children>
                <Label
                        text="Navigation"
                        styleClass="menu-heading"/>

                <Button
                        maxWidth="Infinity"
                        onAction="#handleDashboard"
                        text="Dashboard"
                        styleClass="menu-button"/>

                <Button
                        maxWidth="Infinity"
                        onAction="#handleCategories"
                        text="Categories"
                        styleClass="menu-button"/>

                <Button
                        maxWidth="Infinity"
                        onAction="#handleSuppliers"
                        text="Suppliers"
                        styleClass="menu-button"/>

                <Button
                        maxWidth="Infinity"
                        onAction="#handleProducts"
                        text="Products"
                        styleClass="menu-button"/>

                <Button
                        maxWidth="Infinity"
                        onAction="#handleStockManagement"
                        text="Stock Management"
                        styleClass="menu-button"/>

                <Button
                        maxWidth="Infinity"
                        onAction="#handleMovementHistory"
                        text="Movement History"
                        styleClass="menu-button"/>

                <Button
                        maxWidth="Infinity"
                        onAction="#handleInventoryReport"
                        text="Inventory Report"
                        styleClass="menu-button"/>

                <Region VBox.vgrow="ALWAYS"/>

                <Button
                        maxWidth="Infinity"
                        onAction="#handleLogout"
                        text="Logout"
                        styleClass="logout-button"/>
            </children>
        </VBox>
    </left>

</BorderPane>